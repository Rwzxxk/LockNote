cabal-version:      3.0
name:               notas
version:            0.1.0.0
synopsis:           Bloco de notas com suporte a texto e código
build-type:         Simple

executable notas
    main-is:          Main.hs
    hs-source-dirs:   app
    default-language: Haskell2010
    ghc-options:      -Wall -threaded -rtsopts
    build-depends:
        base                  >=4.18 && <5,
        aeson                 >=2.1,
        text                  >=2.0,
        time                  >=1.12,
        http-types            >=0.12,
        scotty                >=0.22,
        sqlite-simple         >=0.4.19,
        wai-middleware-static >=0.9
